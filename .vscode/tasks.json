{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Cucumber: current feature",
            "type": "shell",
            "command": "./gradlew",
            "args": [
                "cucumberFeature",
                "-Pfeature=${relativeFile}",
                "--console=plain"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "problemMatcher": []
        }
    ]
}
